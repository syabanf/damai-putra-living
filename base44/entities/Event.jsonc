{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description / narrative"
    },
    "category": {
      "type": "string",
      "enum": [
        "community",
        "cultural",
        "food",
        "music",
        "sport",
        "festival",
        "wellness",
        "commercial"
      ],
      "description": "Event category"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date"
    },
    "start_time": {
      "type": "string",
      "description": "Start time e.g. 10:00"
    },
    "end_time": {
      "type": "string",
      "description": "End time e.g. 22:00"
    },
    "location": {
      "type": "string",
      "description": "Location name"
    },
    "address": {
      "type": "string",
      "description": "Full address"
    },
    "map_url": {
      "type": "string",
      "description": "Google Maps URL"
    },
    "banner_image": {
      "type": "string",
      "description": "Banner/hero image URL"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery image URLs"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "ongoing",
        "past"
      ],
      "default": "upcoming"
    },
    "organizer": {
      "type": "string",
      "description": "Event organizer name"
    },
    "ticket_url": {
      "type": "string",
      "description": "External ticket / registration URL"
    }
  },
  "required": [
    "title",
    "start_date"
  ]
}