{
  "name": "Lottery",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Nama undian"
    },
    "description": {
      "type": "string",
      "description": "Deskripsi undian"
    },
    "prizes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "description": "Daftar hadiah di roulette"
    },
    "points_per_entry": {
      "type": "number",
      "description": "Poin yang diperlukan untuk ikut undian",
      "default": 100
    },
    "max_entries_per_user": {
      "type": "number",
      "description": "Maksimal berapa kali user bisa ikut undian ini",
      "default": 3
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "image_url": {
      "type": "string",
      "description": "Banner image URL"
    },
    "winner_announced": {
      "type": "boolean",
      "default": false
    },
    "winner_name": {
      "type": "string"
    },
    "winner_email": {
      "type": "string"
    },
    "winner_prize": {
      "type": "string"
    },
    "total_entries": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}