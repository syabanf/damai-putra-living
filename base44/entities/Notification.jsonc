{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "unit_approved",
        "unit_rejected",
        "permit_approved",
        "permit_rejected",
        "info"
      ],
      "default": "info"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "reference_id": {
      "type": "string",
      "description": "ID of related unit or ticket"
    }
  },
  "required": [
    "title",
    "message"
  ]
}