{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "Created",
        "Submitted",
        "Status Changed",
        "Approved",
        "Rejected",
        "Revision Requested",
        "Document Uploaded",
        "Inspection Added",
        "Comment Added",
        "Deposit Updated"
      ]
    },
    "activity_description": {
      "type": "string"
    },
    "performed_by": {
      "type": "string"
    },
    "performed_at": {
      "type": "string",
      "format": "date-time"
    },
    "old_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    }
  },
  "required": [
    "application_id",
    "activity_type",
    "performed_by"
  ]
}