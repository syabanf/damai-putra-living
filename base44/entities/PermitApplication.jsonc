{
  "name": "PermitApplication",
  "type": "object",
  "properties": {
    "permit_number": {
      "type": "string",
      "description": "Auto-generated permit number e.g. DP/RNV-MIN/2026/001"
    },
    "report_number": {
      "type": "string"
    },
    "permit_type": {
      "type": "string",
      "enum": [
        "Minor Renovation",
        "Major Renovation"
      ],
      "description": "Type of renovation permit"
    },
    "application_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Under Review",
        "Revision Needed",
        "Approved",
        "Rejected",
        "Closed"
      ],
      "default": "Draft"
    },
    "submission_date": {
      "type": "string",
      "format": "date"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "duration_days": {
      "type": "number"
    },
    "applicant_name": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "cluster_name": {
      "type": "string"
    },
    "block_number": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "Rumah",
        "Ruko",
        "Other"
      ]
    },
    "renovation_description": {
      "type": "string"
    },
    "work_scope_summary": {
      "type": "string"
    },
    "notes_from_applicant": {
      "type": "string"
    },
    "attachment_design_drawing": {
      "type": "string"
    },
    "attachment_supporting_documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attachment_imb_or_building_permit": {
      "type": "string"
    },
    "deposit_amount": {
      "type": "number"
    },
    "deposit_status": {
      "type": "string",
      "enum": [
        "Not Required",
        "Pending Payment",
        "Paid",
        "Released",
        "Forfeited"
      ],
      "default": "Not Required"
    },
    "current_approval_stage": {
      "type": "string"
    },
    "contractor_name": {
      "type": "string"
    },
    "contractor_phone": {
      "type": "string"
    },
    "num_workers": {
      "type": "number"
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "permit_type",
    "applicant_name",
    "unit_number"
  ]
}