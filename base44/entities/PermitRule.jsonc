{
  "name": "PermitRule",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string",
      "description": "null = master rule"
    },
    "rule_code": {
      "type": "string"
    },
    "rule_title": {
      "type": "string"
    },
    "rule_description": {
      "type": "string"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "Minor",
        "Major",
        "Both"
      ],
      "default": "Both"
    },
    "acknowledged_by_applicant": {
      "type": "boolean",
      "default": false
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Compliant",
        "Non-Compliant",
        "Waived"
      ]
    },
    "reviewer_notes": {
      "type": "string"
    },
    "is_mandatory": {
      "type": "boolean",
      "default": true
    },
    "is_master": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "rule_title"
  ]
}