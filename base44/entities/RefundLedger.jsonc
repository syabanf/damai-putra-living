{
  "name": "RefundLedger",
  "type": "object",
  "properties": {
    "refund_request_id": {
      "type": "string"
    },
    "ledger_reference_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "accounting_period_from": {
      "type": "string",
      "format": "date"
    },
    "accounting_period_to": {
      "type": "string",
      "format": "date"
    },
    "debit_amount": {
      "type": "number",
      "default": 0
    },
    "credit_amount": {
      "type": "number",
      "default": 0
    },
    "balance_amount": {
      "type": "number",
      "default": 0
    },
    "accounting_status": {
      "type": "string",
      "enum": [
        "Open",
        "Adjusted",
        "Cleared",
        "Paid"
      ],
      "default": "Open"
    },
    "ledger_snapshot_file": {
      "type": "string"
    },
    "finance_verification_notes": {
      "type": "string"
    }
  },
  "required": [
    "refund_request_id",
    "ledger_reference_number"
  ]
}