{
  "name": "LotteryEntry",
  "type": "object",
  "properties": {
    "lottery_id": {
      "type": "string",
      "description": "ID undian"
    },
    "lottery_title": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "points_spent": {
      "type": "number"
    },
    "spin_result": {
      "type": "string",
      "description": "Hasil spin roulette"
    },
    "entry_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "lottery_id",
    "user_email"
  ]
}