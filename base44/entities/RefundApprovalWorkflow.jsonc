{
  "name": "RefundApprovalWorkflow",
  "type": "object",
  "properties": {
    "refund_request_id": {
      "type": "string"
    },
    "approval_stage": {
      "type": "string"
    },
    "approver_role": {
      "type": "string"
    },
    "approver_name": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected",
        "Revision Needed"
      ],
      "default": "Pending"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    },
    "approval_notes": {
      "type": "string"
    },
    "digital_signature": {
      "type": "string"
    },
    "sequence_order": {
      "type": "number"
    }
  },
  "required": [
    "refund_request_id",
    "approval_stage",
    "sequence_order"
  ]
}