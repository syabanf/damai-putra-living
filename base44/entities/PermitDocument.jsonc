{
  "name": "PermitDocument",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Design Drawing",
        "IMB/Building Permit",
        "KTP/ID",
        "Ownership Certificate",
        "Contractor License",
        "Material Specification",
        "Site Photo",
        "Approval Letter",
        "Other"
      ]
    },
    "document_name": {
      "type": "string"
    },
    "document_file": {
      "type": "string"
    },
    "upload_date": {
      "type": "string",
      "format": "date-time"
    },
    "uploaded_by": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "default": 1
    },
    "is_required": {
      "type": "boolean",
      "default": false
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Verified",
        "Rejected"
      ],
      "default": "Pending"
    }
  },
  "required": [
    "application_id",
    "document_type",
    "document_name"
  ]
}